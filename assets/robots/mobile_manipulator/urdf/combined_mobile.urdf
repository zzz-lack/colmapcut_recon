    <inertial>
      <origin rpy="0 0 0" xyz="-2.10804165790002E-10 -0.0299032533481438 -5.84597248387553E-09"/>
      <mass value="1.0028"/>
      <inertia ixx="3.2757E-03" ixy="0" ixz="0" iyy="4.2757E-03" iyz="0" izz="3.2757E-03"/>
    </inertial>
