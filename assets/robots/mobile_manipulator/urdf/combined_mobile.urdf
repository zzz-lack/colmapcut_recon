  <link name="base_footprint">
    <!--
      Isaac Sim imports the URDF root as a dynamic articulation body when the
      base is mobile. Give this otherwise virtual frame a small, positive
      inertia so the root body is never singular.
    -->
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1.0e-6" ixy="0" ixz="0" iyy="1.0e-6" iyz="0" izz="1.0e-6"/>
    </inertial>
