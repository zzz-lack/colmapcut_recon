    </visual>
    <!-- <collision>
				<origin xyz="0 0 0" rpy="0 0 0" />
				<geometry>
					<mesh filename="${stl_collision}" />
				</geometry>
			</collision> -->
    <collision>
      <origin rpy="1.570796 0 0" xyz="0 -0.03 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.09"/>
      </geometry>
    </collision>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <axis xyz="0 -1 0"/>
    <origin rpy="-1.5876E-15 0.80628 -3.206E-15" xyz="-0.115 -0.0318 0"/>
    <parent link="rear_left_leg_link"/>
    <child link="rear_left_wheel_link"/>
