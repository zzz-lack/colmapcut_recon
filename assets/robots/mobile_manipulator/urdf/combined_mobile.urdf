    <inertial>
      <mass value="0.16140"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0003947" ixy="0.0" ixz="3.3365e-8" iyy="2.417e-5" iyz="0.0" izz="0.0003973"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="terrasentia_gazebo/terra_description/models/ZED2.dae"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <mesh filename="terrasentia_gazebo/terra_description/models/ZED2.dae"/>
      </geometry>
    </collision>
  </link>
  <!-- Camera -->
